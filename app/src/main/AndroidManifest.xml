<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".QuickFillApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickFill">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QuickFill">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating Quick Picker Activity launched by the Quick Settings Tile -->
        <activity
            android:name=".ui.QuickPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Transparent Trampoline Activity for reliable foreground clipboard writes -->
        <activity
            android:name=".ui.CopyTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- General Quick Picker Tile -->
        <service
            android:name=".service.QuickCopyTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_picker"
            android:label="@string/tile_picker_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Direct-Copy Slot 1 Tile -->
        <service
            android:name=".service.Slot1TileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_slot1"
            android:label="@string/tile_slot1_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Direct-Copy Slot 2 Tile -->
        <service
            android:name=".service.Slot2TileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_slot2"
            android:label="@string/tile_slot2_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Direct-Copy Slot 3 Tile -->
        <service
            android:name=".service.Slot3TileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_slot3"
            android:label="@string/tile_slot3_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>